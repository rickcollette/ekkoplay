[Unit]
Description=ekkoPlayer music service
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ekkoplayer
Group=ekkoplayer
Environment=EKKOPLAYER_CONFIG=/etc/ekkoplayer/player.json
Environment=TMPDIR=/srv/ekkoplayer/tmp
ExecStart=/opt/ekkoplayer/current/ekkoplayer
Restart=always
RestartSec=2
RuntimeDirectory=ekkoplayer
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/srv/ekkoplayer /run/ekkoplayer

[Install]
WantedBy=multi-user.target
