[Unit]
Description=Create an ekkoPlayer state backup
After=playerd.service

[Service]
Type=oneshot
User=ekkoplayer
Group=ekkoplayer
Environment=EKKOPLAYER_CONFIG=/etc/ekkoplayer/player.json
ExecStart=/opt/ekkoplayer/current/ekkoplayer backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ekkoplayer
