server {
    @@LISTEN@@
    @@TLS@@
    server_name _;
    client_max_body_size 16G;
    client_body_timeout 1h;
    send_timeout 1h;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer always;
    root /opt/ekkoplayer/current/player;
    location / { try_files $uri $uri/ /index.html; }
    location = /admin { return 308 /admin/; }
    location = /admin/ws { proxy_pass http://127.0.0.1:9091; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host $http_host; proxy_read_timeout 1d; }
    location ^~ /admin/ { alias /opt/ekkoplayer/current/admin/; try_files $uri $uri/ /admin/index.html; }
    location /api/ { proxy_pass http://127.0.0.1:9091; proxy_http_version 1.1; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_request_buffering off; proxy_connect_timeout 5s; proxy_read_timeout 1h; }
    location /ws { proxy_pass http://127.0.0.1:9091; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host $http_host; proxy_read_timeout 1d; }
    location /art/ { alias @@ARTWORK@@; access_log off; expires 7d; add_header Cache-Control "public, immutable"; }
}
